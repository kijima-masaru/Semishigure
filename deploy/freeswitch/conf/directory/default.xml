<include>
  <domain name="$${domain}">
    <params>
      <param name="dial-string" value="{^^:sip_invite_domain=${dialed_domain}:presence_id=${dialed_user}@${dialed_domain}}${sofia_contact(*/${dialed_user}@${dialed_domain})}"/>
    </params>
    <variables>
      <variable name="user_context" value="default"/>
    </variables>
    <groups>
      <group name="callers">
        <users>
          <user id="9100">
            <params><param name="password" value="$${ext_password}"/></params>
            <variables>
              <variable name="effective_caller_id_name" value="Caller 9100"/>
              <variable name="effective_caller_id_number" value="9100"/>
            </variables>
          </user>
        </users>
      </group>
      <group name="answerers">
        <users>
          <user id="9001">
            <params><param name="password" value="$${ext_password}"/></params>
            <variables><variable name="effective_caller_id_number" value="9001"/></variables>
          </user>
          <user id="9002">
            <params><param name="password" value="$${ext_password}"/></params>
            <variables><variable name="effective_caller_id_number" value="9002"/></variables>
          </user>
          <user id="9003">
            <params><param name="password" value="$${ext_password}"/></params>
            <variables><variable name="effective_caller_id_number" value="9003"/></variables>
          </user>
          <user id="9004">
            <params><param name="password" value="$${ext_password}"/></params>
            <variables><variable name="effective_caller_id_number" value="9004"/></variables>
          </user>
        </users>
      </group>
    </groups>
  </domain>
</include>
